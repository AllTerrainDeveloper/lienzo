node_modules/
# Anchored, so it means Composer's directory at the repository root -- an unanchored
# `vendor/` also matches assets/vendor/, which silently left the vendored PixiJS out of
# the checkout and made the plugin uninstallable without a build step.
/vendor/
.DS_Store
*.log
.phpunit.result.cache

# Release output. Rebuilt by `npm run plugin:package`, so it is never a source of truth.
/dist/

# Per-machine wp-env overrides. CI writes one to drop the sibling OpenStation mapping,
# which exists only on a development machine -- see .github/workflows/ci.yml.
/.wp-env.override.json

# assets/ is deliberately committed -- the bundles, and the PixiJS that bin/vendor-pixi.mjs
# copies out of node_modules into assets/vendor/ -- because the plugin must be installable
# straight from a checkout, without an npm install. On a site running the desktop shell that
# vendored copy is never loaded; the shell's own is used instead.
